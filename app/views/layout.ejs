<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Hệ Thống Đặt Tour Du Lịch - VietTour' %></title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Font Awesome 6 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="d-flex flex-column min-vh-100">
  <!-- Top Bar -->
  <div class="top-bar py-1 bg-dark text-white-50 text-sm small">
    <div class="container d-flex justify-content-between align-items-center">
      <div>
        <i class="fa-solid fa-phone me-1 text-primary"></i> Hotline: <strong>1900 6868</strong> | 
        <i class="fa-solid fa-envelope ms-2 me-1 text-primary"></i> booking@viettour.vn
      </div>
      <div>
        <span class="badge bg-secondary me-2">SVTH: Phí Đức Phi - DTC241200011</span>
        <span class="badge bg-primary">Đề 20: Booking Tour</span>
      </div>
    </div>
  </div>

  <!-- Navigation -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary sticky-top shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold d-flex align-items-center" href="/">
        <i class="fa-solid fa-plane-departure me-2 fs-3"></i>
        <span>VietTour <span class="badge bg-light text-primary fs-7">Pro</span></span>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarMain">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item">
            <a class="nav-link <%= currentPath === '/' ? 'active fw-bold' : '' %>" href="/">
              <i class="fa-solid fa-house me-1"></i> Trang Chủ
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= currentPath.startsWith('/tours') ? 'active fw-bold' : '' %>" href="/tours">
              <i class="fa-solid fa-map-location-dot me-1"></i> Khám Phá Tour
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= currentPath.startsWith('/bookings/lookup') ? 'active fw-bold' : '' %>" href="/bookings/lookup">
              <i class="fa-solid fa-magnifying-glass me-1"></i> Tra Cứu Booking
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= currentPath.startsWith('/admin') ? 'active fw-bold' : '' %>" href="/admin">
              <i class="fa-solid fa-sliders me-1"></i> Quản Trị Hệ Thống
            </a>
          </li>
        </ul>

        <div class="d-flex align-items-center gap-2">
          <a href="/metrics" target="_blank" class="btn btn-outline-light btn-sm" title="Xem Prometheus Metrics">
            <i class="fa-solid fa-chart-line me-1"></i> Metrics
          </a>
          <a href="/healthz" target="_blank" class="btn btn-outline-light btn-sm" title="Health Check">
            <i class="fa-solid fa-heart-pulse text-success me-1"></i> Health
          </a>
        </div>
      </div>
    </div>
  </nav>

  <!-- Main Content Body -->
  <main class="flex-grow-1">
    <%- body %>
  </main>

  <!-- Footer -->
  <footer class="bg-dark text-white pt-5 pb-3 mt-5">
    <div class="container">
      <div class="row g-4">
        <div class="col-lg-4 col-md-6">
          <h5 class="fw-bold mb-3 text-white"><i class="fa-solid fa-plane-departure text-primary me-2"></i>VietTour Booking</h5>
          <p class="text-white-50">
            Hệ thống đặt tour du lịch thông minh, tiện lợi và an toàn. Dự án phục vụ môn học Triển khai Hệ thống & DevOps.
          </p>
          <p class="small text-white-50 mb-1">
            <strong>Đề tài 20:</strong> Hệ thống Booking Tour / Du lịch<br>
            <strong>Sinh viên thực hiện:</strong> Phí Đức Phi - MSV: DTC241200011
          </p>
        </div>
        <div class="col-lg-2 col-md-6">
          <h6 class="fw-bold text-uppercase text-light mb-3">Liên Kết Nhanh</h6>
          <ul class="list-unstyled text-white-50 small">
            <li class="mb-2"><a href="/" class="text-white-50 text-decoration-none hover-primary">Trang Chủ</a></li>
            <li class="mb-2"><a href="/tours" class="text-white-50 text-decoration-none hover-primary">Danh Sách Tour</a></li>
            <li class="mb-2"><a href="/bookings/lookup" class="text-white-50 text-decoration-none hover-primary">Tra Cứu Vé</a></li>
            <li class="mb-2"><a href="/admin" class="text-white-50 text-decoration-none hover-primary">Bảng Điều Khiển</a></li>
          </ul>
        </div>
        <div class="col-lg-3 col-md-6">
          <h6 class="fw-bold text-uppercase text-light mb-3">Công Nghệ & DevOps</h6>
          <ul class="list-unstyled text-white-50 small">
            <li class="mb-1"><i class="fa-brands fa-node-js text-success me-2"></i>Node.js Express + EJS</li>
            <li class="mb-1"><i class="fa-solid fa-database text-info me-2"></i>PostgreSQL 16 + pgAdmin 4</li>
            <li class="mb-1"><i class="fa-solid fa-server text-warning me-2"></i>Nginx Reverse Proxy (SSL)</li>
            <li class="mb-1"><i class="fa-solid fa-chart-pie text-danger me-2"></i>Prometheus + Grafana</li>
            <li class="mb-1"><i class="fa-solid fa-file-waveform text-primary me-2"></i>Loki + Promtail LogQL</li>
          </ul>
        </div>
        <div class="col-lg-3 col-md-6">
          <h6 class="fw-bold text-uppercase text-light mb-3">Liên Hệ Trợ Giúp</h6>
          <p class="small text-white-50 mb-1"><i class="fa-solid fa-location-dot me-2 text-primary"></i>Hà Nội, Việt Nam</p>
          <p class="small text-white-50 mb-1"><i class="fa-solid fa-phone me-2 text-primary"></i>1900 6868 / 0987.654.321</p>
          <p class="small text-white-50 mb-1"><i class="fa-solid fa-envelope me-2 text-primary"></i>support@viettour.vn</p>
        </div>
      </div>
      <hr class="border-secondary my-4">
      <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center text-white-50 small">
        <div>© 2024 VietTour - Đề án Triển khai Hệ thống. Mã sinh viên: <strong>DTC241200011</strong></div>
        <div class="mt-2 mt-sm-0">
          <span class="badge bg-success-subtle text-success border border-success me-1">Docker Compose</span>
          <span class="badge bg-info-subtle text-info border border-info me-1">Hardened Security</span>
          <span class="badge bg-warning-subtle text-warning border border-warning">Prometheus Monitored</span>
        </div>
      </div>
    </div>
  </footer>

  <!-- Bootstrap 5 JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Custom Script -->
  <script src="/js/main.js"></script>
</body>
</html>

